Screen {
    background: #0b0f19;
}

#workspace {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 1 1;
    grid-gutter: 1;
    padding: 1;
}

TileWindow {
    border: solid #1e293b;
    background: #0f172a;
    padding: 1 2;
    height: 100%;
}

TileWindow:focus {
    border: solid #22d3ee;
    background: #0f172a;
}

.widget-title {
    color: #38bdf8;
    text-style: bold;
    margin-bottom: 1;
}

#launcher-overlay {
    dock: bottom;
    width: 45;
    height: 12;
    margin: 0 2 2 0;
    align: right bottom;
    border: double #22d3ee;
    background: #111827;
    padding: 1;
}
#launcher-title {
    text-align: center;
    text-style: bold;
    color: #22d3ee;
    margin-bottom: 1;
}

#launcher-list {
    background: transparent;
    border: none;
}

#launcher-list ListItem {
    padding: 0 1;
}

#launcher-list ListItem:focus {
    background: #1e293b;
    color: #22d3ee;
}

.project-sidebar-pane {
    width: 30%;
    height: 100%;
    border-right: dashed #1e293b;
    background: transparent;
}

.project-detail-pane {
    width: 70%;
    height: 100%;
    padding: 0 2;
}

#project-list ListItem:focus {
  background: #1e293b;
  color: #38bdf8;
  text-style: bold;
}

.vanguard-sidebar {
    width: 30%;
    height: 100%;
    border-right: dashed #1e293b;
    background: transparent;
}

.vanguard-console {
    width: 70%;
    height: 100%;
    padding: 0 2;
}

#vanguard-target-list ListItem:focus {
    background: #1e293b;
    color: #f43f5e;
    text-style: bold;
}
